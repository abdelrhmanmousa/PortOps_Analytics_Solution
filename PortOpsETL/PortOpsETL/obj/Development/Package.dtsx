          DTS:DTSID="{E5E1EA0F-251D-4177-8400-DA99C6FE9695}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="generate Date_dim"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7E822E61-C392-4C39-97FF-45EFB8469510}"
              SQLTask:SqlStatementSource="-- 1. Create the -1 Unknown Row if it doesn't exist&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_date WHERE date_key = -1)&#xA;BEGIN&#xA;    INSERT INTO dw.dim_date (date_key, full_date, fiscal_month, fiscal_year)&#xA;    VALUES (-1, '1900-01-01', 0, 0);&#xA;END&#xA;&#xA;-- 2. Generate dates for the reporting period (1 April 2025 – 31 March 2026)&#xA;DECLARE @StartDate DATE = '2025-04-01';&#xA;DECLARE @EndDate DATE = '2026-03-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    DECLARE @DateKey INT = (YEAR(@StartDate) * 10000) + (MONTH(@StartDate) * 100) + DAY(@StartDate);&#xA;    &#xA;    -- FISCAL LOGIC: If month is Jan(1), Feb(2), Mar(3), the Fiscal Year is Prev Year.&#xA;    -- Fiscal Month: April(4) becomes 1, May(5) becomes 2... March(3) becomes 12.&#xA;    &#xA;    INSERT INTO dw.dim_date (&#xA;        date_key, &#xA;        full_date, &#xA;        fiscal_month, &#xA;        fiscal_year&#xA;    )&#xA;    VALUES (&#xA;        @DateKey,&#xA;        @StartDate,&#xA;        CASE &#xA;            WHEN MONTH(@StartDate) &gt;= 4 THEN MONTH(@StartDate) - 3 &#xA;            ELSE MONTH(@StartDate) + 9 &#xA;        END, -- Fiscal Month (April = 1)&#xA;        CASE &#xA;            WHEN MONTH(@StartDate) &gt;= 4 THEN YEAR(@StartDate) &#xA;            ELSE YEAR(@StartDate) - 1 &#xA;        END  -- Fiscal Year (April starts the year)&#xA;    );&#xA;&#xA;    SET @StartDate = DATEADD(DAY, 1, @StartDate);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>

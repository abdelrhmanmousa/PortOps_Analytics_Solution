                      expressionType="Notify"
                      name="SqlCommandParam"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT shift_id , shift_name , start_time , end_time
from dw.dim_shift) [refTable]
where [refTable].[shift_id] = ? and [refTable].[shift_name] = ? and [refTable].[start_time] = ? and [refTable].[end_time] = ?</property>
